APP_NAME=Binance Prediction Tracker
APP_ENV=development
APP_DEBUG=true
AUTO_START_JOBS=false
AUTO_BACKFILL_ON_START=true
STARTUP_BACKFILL_LIMIT=300
STARTUP_MIN_CANDLES=120

# MySQL example:
DATABASE_URL=mysql+pymysql://bpt_user:bpt_password@127.0.0.1:3306/binance_prediction_tracker?charset=utf8mb4

# For quick local test without MySQL, you may use SQLite:
# DATABASE_URL=sqlite:///./local.db

BINANCE_REST_BASE_URL=https://data-api.binance.vision
BINANCE_VERIFY_SSL=true
SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT,ADAUSDT,DOGEUSDT,TRXUSDT,AVAXUSDT,LINKUSDT,DOTUSDT,LTCUSDT
TIMEFRAMES=1m,5m,15m
PREDICTION_TIMEFRAME=5m
HORIZONS_MINUTES=10
MIN_CONFIDENCE=0.74
THRESHOLD_SHORT=0.0010
THRESHOLD_LONG=0.0018
PAPER_POSITION_USD=5
FUTURES_MODE=true
FUTURES_LEVERAGE=10
TAKE_PROFIT_PERCENT=0.0040
STOP_LOSS_PERCENT=0.0025
NEAR_STOP_PERCENT=0.95
SIGNAL_COOLDOWN_MINUTES=5
MAX_OPEN_POSITIONS=5
PERFORMANCE_GUARD_ENABLED=true
PERFORMANCE_GUARD_MIN_RESULTS=20
PERFORMANCE_GUARD_MIN_ACCURACY=0.35
PERFORMANCE_GUARD_MIN_PNL_USD=-0.75
COLLECTOR_INTERVAL_SECONDS=30
EVALUATOR_INTERVAL_SECONDS=20
