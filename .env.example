APP_NAME=Binance Prediction Tracker
APP_ENV=development
APP_DEBUG=true

# MySQL example:
DATABASE_URL=mysql+pymysql://bpt_user:bpt_password@127.0.0.1:3306/binance_prediction_tracker?charset=utf8mb4

# For quick local test without MySQL, you may use SQLite:
# DATABASE_URL=sqlite:///./local.db

BINANCE_REST_BASE_URL=https://data-api.binance.vision
BINANCE_VERIFY_SSL=true
SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT
TIMEFRAMES=1m,5m,15m
PREDICTION_TIMEFRAME=1m
HORIZONS_MINUTES=3,5,10
MIN_CONFIDENCE=0.65
THRESHOLD_SHORT=0.0005
THRESHOLD_LONG=0.0010
COLLECTOR_INTERVAL_SECONDS=30
EVALUATOR_INTERVAL_SECONDS=20
